<section class="section page-width">
  <div class="section__head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.collection != blank -%}
      <a href="{{ section.settings.collection.url }}" class="link-arrow">View all</a>
    {%- endif -%}
  </div>

  {%- assign source = section.settings.collection | default: collections.all -%}
  <div class="grid">
    {%- for product in source.products limit: section.settings.products_count -%}
      {% render 'product-card', product: product %}
    {%- else -%}
      <p>Add products to this collection to show them here.</p>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_count", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
