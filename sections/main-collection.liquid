<section class="section page-width">
  <div class="section__head">
    <h1>{{ collection.title }}</h1>
  </div>
  {%- if collection.description != blank -%}
    <div class="rte collection__desc">{{ collection.description }}</div>
  {%- endif -%}

  {%- paginate collection.products by 12 -%}
    <div class="grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p>No products found in this collection yet.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Prev</a>{%- endif -%}
        <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
