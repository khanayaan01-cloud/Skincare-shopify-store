<section class="section page-width page-narrow">
  <h1>{{ page.title }}</h1>
  {%- if page.content != blank -%}
    <div class="rte">{{ page.content }}</div>
  {%- endif -%}

  {% form 'contact', class: 'contact-form' %}
    {%- if form.posted_successfully? -%}
      <p class="form-ok">{{ section.settings.success_text }}</p>
    {%- endif -%}
    {%- if form.errors -%}
      <div class="form-error">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    <label for="contact-name">Name</label>
    <input id="contact-name" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>

    <label for="contact-email">Email</label>
    <input id="contact-email" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>

    <label for="contact-phone">Phone (optional)</label>
    <input id="contact-phone" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">

    <label for="contact-body">Message</label>
    <textarea id="contact-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea>

    <button type="submit" class="btn">Send message</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks for contacting us. We will get back to you soon." }
  ]
}
{% endschema %}
