<section class="newsletter">
  <div class="page-width newsletter__inner">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {% form 'customer', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-ok">Thanks for subscribing!</p>
      {%- endif -%}
      <div class="inline-form">
        <input type="email" name="contact[email]" placeholder="Your email" aria-label="Email" required>
        <button type="submit" class="btn">Subscribe</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join the Glow Lab list for new launches and skin tips." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
