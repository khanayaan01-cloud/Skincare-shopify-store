<section class="hero{% if section.settings.text_color == 'light' %} hero--light{% endif %}">
  {%- if section.settings.image != blank -%}
    <img class="hero__bg" src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.image.alt | escape }}" loading="eager" width="2000">
    <div class="hero__overlay" style="opacity: {{ section.settings.overlay | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <div class="page-width hero__inner">
    <div class="hero__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      <p class="hero__sub">{{ section.settings.subheading }}</p>
      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Overlay strength (makes text easier to read)", "default": 35 },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text color",
      "options": [
        { "value": "dark", "label": "Dark text (for light images)" },
        { "value": "light", "label": "White text (for dark images)" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Clean. Simple. Glowing." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Skincare for your everyday glow" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Gentle, thoughtfully made skincare for a simple daily routine." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
