<div class="password">
  <h1 class="password__title">{{ shop.name }}</h1>
  <p>Our store is getting ready. Something glowing is coming soon.</p>
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <div class="password__row">
      <input type="password" name="password" placeholder="Enter password" aria-label="Password" required>
      <button type="submit" class="btn">Enter</button>
    </div>
  {% endform %}
</div>
